{
  "name": "spacyes-static-assets-toolchain",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "preinstall": "node scripts/cloudflare-toolchain.mjs install",
    "build": "node scripts/cloudflare-toolchain.mjs build",
    "dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8797 --show-interactive-dev-session=false",
    "validate:config": "node scripts/validate-cloudflare-config.mjs",
    "test:staging": "node --test scripts/stage-public-assets.test.mjs",
    "test:cloudflare": "node --test scripts/cloudflare-toolchain.test.mjs",
    "test:routing": "node scripts/check-local-routing.mjs",
    "preview": "node scripts/cloudflare-toolchain.mjs preview",
    "deploy": "node scripts/cloudflare-toolchain.mjs deploy"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "wrangler": "4.161.0"
  }
}
