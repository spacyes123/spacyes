# INACTIVE TEMPLATE. Rename into .github/workflows/ only in an approved activation PR.
name: Controlled Pages release
on:
  workflow_dispatch:
    inputs:
      release_sha:
        description: Exact reviewed current main SHA
        required: true
        type: string
permissions:
  contents: read
  actions: read
concurrency:
  group: controlled-pages-production
  cancel-in-progress: false
jobs:
  verify:
    if: github.repository == 'spacyes123/spacyes' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Verify approval and environment protection before checkout
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_SHA: ${{ inputs.release_sha }}
          APPROVED_SHA: ${{ vars.SPACYES_PAGES_RELEASE_SHA }}
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[a-f0-9]{40}$ ]]
          [[ "$RELEASE_SHA" == "$APPROVED_SHA" && "$RELEASE_SHA" == "$GITHUB_SHA" ]]
          [[ "$(gh api repos/spacyes123/spacyes/branches/main --jq .commit.sha)" == "$RELEASE_SHA" ]]
          gh api repos/spacyes123/spacyes/environments/github-pages > "$RUNNER_TEMP/pages-environment.json"
          node --input-type=module - "$RUNNER_TEMP/pages-environment.json" <<'NODE'
          import { readFileSync } from 'node:fs';
          const e = JSON.parse(readFileSync(process.argv[2], 'utf8'));
          if (e.can_admins_bypass !== false || !e.protection_rules?.some(r =>
            r.type === 'required_reviewers' && r.prevent_self_review === true && r.reviewers?.length > 0)) {
            throw new Error('Required independent reviewers and disabled admin bypass must be configured first');
          }
          NODE
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.release_sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22'
      - name: Verify origin/main history
        run: git show-ref --verify refs/remotes/origin/main
      - run: npm ci --include=dev
      - run: node scripts/verify-linux-staging.mjs
      - run: npm run build
      - run: npm run test:cloudflare
      - run: node scripts/verify-publication.mjs
      - run: git diff --exit-code
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa
        with:
          path: public
          retention-days: 1
  publish:
    needs: verify
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Publish approved artifact
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e
